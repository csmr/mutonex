{
  "compilerOptions": {
    "lib": [
      "deno.window",
      "dom"
    ]
  },
  "dependencies": {},
  "fmt": {
    "options": {
      "semiColons": true,
      "singleQuote": true,
      "trailingCommas": "onlyMultiLine",
      "lineWidth": 68,
      "useTabs": false
    },
    "exclude": ["**/*.js", "deno.*", "**/*.json"]
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "tasks": {
    "dev": "deno run --watch server/app.ts",
    "bundle-client": "esbuild core/main.ts --bundle --outfile=../dist/web.js",
    "bundle-client-esbuild-module": "deno run -A npm:esbuild@^0.24.0 core/main.ts --bundle --outfile=../dist/web.js --define:__DEV_MODE_ENABLED__=\"\\\"$DEV_MODE_ENABLED\\\"\" --external:https://cdn.skypack.dev/three@0.136.0 --external:https://cdn.skypack.dev/three@0.136.0/examples/jsm/controls/OrbitControls.js --external:https://cdn.jsdelivr.net/npm/phoenix@1.7.11/priv/static/phoenix.mjs"
  },
  "imports": {
    "@denodeland/knex": "npm:@denodeland/knex@^2.5.4",
    "esbuild": "npm:esbuild@^0.24.0"
  }
}